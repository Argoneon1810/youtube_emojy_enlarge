{
  "manifest_version": 3,
  "name": "유튜브 라이브 이모지 확장기",
  "version": "1.0",
  "description": "유튜브 라이브 채팅의 이모지 패널 크기를 토글합니다.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}